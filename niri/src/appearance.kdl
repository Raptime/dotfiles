/////////////////////////////////////////////////
// Gestures
//
gestures {
    hot-corners {
        off
    }
}

/////////////////////////////////////////////////
// Layout
//
layout {
    background-color "transparent"
    gaps 16
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    struts
}

/////////////////////////////////////////////////
// Overview
//
overview {
  workspace-shadow {
    off
  }
}

/////////////////////////////////////////////////
// Workspaces
//
//workspace "browser"

/////////////////////////////////////////////////
// Defaults
//
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true

  background-effect {
    blur true
    xray false
  }
}

// Make inactive windows semitransparent.
window-rule {
    match is-active=false

    opacity 0.80
}

/////////////////////////////////////////////////
// Noctalia settings
//
// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

// Noctalia wallpaper
// Option 1: Blurred - needs [niri/backdrop] in noctalia conf
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}
// Option 2: Stationary
/-layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// Noctalia surfaces
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"

    background-effect {
        // blur false
        xray false
    }
}

// Noctalia window switcher
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

/////////////////////////////////////////////////
// Firefox
//
window-rule {
  // match at-startup=true app-id="firefox"
  match app-id="firefox"

  open-maximized true
  // open-floating true
  // open-on-workspace "browser"
}

// Open the Firefox picture-in-picture window as floating with 480×270 size.
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"

    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}
